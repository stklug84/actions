# ignore global .gitignore
!*
.DS_Store

# ignore merge files
*.orig

# ignore html files
*.html

# ignore VSCode files
.vscode/
*.code-workspace

# ignore Python bytecode caches
__pycache__/
*.pyc

# ignore npm installs (revealjs/build-html vendors from its lockfile into RUNNER_TEMP)
node_modules/

# ignore scratch output of the revealjs test suites
revealjs/build-html/test/.scratch/
revealjs/build-html/test/.integration/
revealjs/build-html/test/.e2e/
